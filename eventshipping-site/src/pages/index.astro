---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import Services from '../components/Services.astro';
import FAQ from '../components/FAQ.astro';
import Contact from '../components/Contact.astro';
import Resources from '../components/Resources.astro';
import {site,industries} from '../data/site';
---
<Layout title="Trade Show & Time-Critical Freight | Event Shipping" description="Your event has a deadline. Coordinate trade show, conference and event freight by land, air and sea with Event Shipping. One-way, round-trip and worldwide.">
<section class="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow">Trade show & event freight specialists</p><h1>Your event has<br/>a deadline.<br/><span>We get it.</span></h1><p class="intro">Trade shows, conferences and time-critical freight. One-way or round-trip, by land, air and sea — with personal support at every step.</p><div class="hero-actions"><a class="button button--primary" href="/contact/">Request a Rate Quote<Icon name="arrow-up-right"/></a><a class="button button--secondary" href={site.phoneHref}><Icon name="phone" size={18}/>{site.phone}</a></div><p class="hero-note"><span></span>Here for your next move. 7 days a week.</p></div><figure class="hero-freight"><Photo name="land-air-sea" alt="Airplane, freight truck and container ship representing land, air and sea shipping" priority/><figcaption><span>LAND. AIR. SEA.</span><span>One coordinated move.</span></figcaption></figure></div></section>
<div class="service-strip"><div class="container">{[{icon:'route',label:'One-way & round-trip'},{icon:'world',label:'Domestic & worldwide'},{icon:'clock',label:'Time-critical coordination'}].map(v=><div><Icon name={v.icon} size={22}/><span>{v.label}</span></div>)}</div></div>
<Services/>
<section class="section support-section" id="how-it-works"><div class="container support-grid"><div><Photo name="event-cases" alt="Wooden crates and protective cases ready for an event shipment"/><p class="photo-caption">Exhibit cases, crates, pallets and everything your event needs.</p></div><div><p class="eyebrow">Your personal shipping assistant</p><h2>More than a shipment.<br/>A plan from start to finish.</h2><p class="support-intro">A real team to help you choose a service, coordinate the details and keep your freight moving.</p><ol class="steps"><li><span class="step-number">01</span><div><h3>Tell us where. And when.</h3><p>Share your event dates, route, weight and dimensions. We’ll talk through the options.</p></div></li><li><span class="step-number">02</span><div><h3>We connect the details.</h3><p>Pickup, delivery appointments, waybills and labels. Coordinated around your event.</p></div></li><li><span class="step-number">03</span><div><h3>Stay in the loop.</h3><p>Tracking updates, route changes and proof of delivery. Support for the move and the return.</p></div></li></ol><a class="text-link" href="/domestic-shipping/">See how we support your event<Icon name="arrow-right"/></a></div></div></section>
<section class="service-cta"><div class="container service-cta-inner"><div><p class="eyebrow">When the schedule changes</p><h2>A new deadline?<br/>Let’s work on the next move.</h2><p>Talk to our team about expedited ground and air options.</p></div><a class="button button--light" href={site.phoneHref}><Icon name="phone"/>Call {site.phone}</a></div></section>
<section class="section industries-section"><div class="container industries-layout"><div><p class="eyebrow">Built around your business</p><h2>Wherever your<br/>next event takes you.</h2><p>Convention centers, hotels, productions and venues. We help move the materials behind the experience.</p></div><ul class="industry-list">{industries.map(i=><li><Icon name="check" size={18}/>{i}</li>)}</ul></div></section>
<Resources/><FAQ/><Contact/>
</Layout>
