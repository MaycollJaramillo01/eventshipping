---
interface Props { name: string; alt: string; portrait?: boolean; priority?: boolean; class?: string; sizes?: string; }
const { name, alt, portrait = false, priority = false, class: className, sizes = '(min-width: 1024px) 540px, (min-width: 768px) 45vw, calc(100vw - 40px)' } = Astro.props;
const widths = [480, 768, 1200];
const source = (format: string) => widths.map(w => `/images/${name}-${w}.${format} ${w}w`).join(', ');
---
<picture class:list={['photo', className, { 'photo--portrait': portrait }]}>
  <source type="image/avif" srcset={source('avif')} sizes={sizes} />
  <img src={`/images/${name}-${widths[1]}.webp`} srcset={source('webp')} sizes={sizes} alt={alt} width="1200" height="800" loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding="async" />
</picture>
