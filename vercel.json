{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix eventshipping-site",
  "buildCommand": "npm run build --prefix eventshipping-site",
  "outputDirectory": "eventshipping-site/dist",
  "trailingSlash": true,
  "proxy": {
    "entrypoint": "eventshipping-site/middleware.ts",
    "matcher": "/((?!_astro/|images/|fonts/|licenses/|assets/|_vercel/|\\.well-known/|favicon\\.png|robots\\.txt|sitemap.*\\.xml).*)"
  },
  "redirects": [
    { "source": "/contact-us/quote", "destination": "/contact/", "permanent": true },
    { "source": "/contact-us%2Fquote", "destination": "/contact/", "permanent": true }
  ]
}
